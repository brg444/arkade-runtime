FROM golang:1.26.6@sha256:640a234f4bea3e399c056b7b8f9c667c4939befae8db2f14e9785e16eccd4205 AS builder

WORKDIR /src
COPY go.mod go.sum ./
COPY api-spec/go.mod api-spec/go.sum ./api-spec/
COPY pkg/arkade/go.mod pkg/arkade/go.sum ./pkg/arkade/
COPY pkg/client/go.mod pkg/client/go.sum ./pkg/client/
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/vault-authorizer ./poc/2fa-vault/cmd/authorizer

FROM alpine:3.24.1@sha256:28bd5fe8b56d1bd048e5babf5b10710ebe0bae67db86916198a6eec434943f8b
RUN apk add --no-cache ca-certificates \
    && addgroup -S -g 10001 vault \
    && adduser -S -D -H -u 10001 -G vault vault \
    && install -d -o vault -g vault -m 0700 /app/data
COPY --from=builder /out/vault-authorizer /usr/local/bin/vault-authorizer
USER 10001:10001
WORKDIR /app

# This image contains no web assets, private test key, generic/gRPC signer
# client, or generic signing server. It contains only the narrow release-pinned
# HTTPS client for the independent public Arkade cosigner. The public
# generator-G identity remains linked only so startup can reject that fixture
# and its negation. Compose mounts the real VaultCosigner key read-only and SQLite
# at /app/data, then connects this listener only to the private gateway network.
ENTRYPOINT ["vault-authorizer"]
