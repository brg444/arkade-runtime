# Non-secret mainnet contract for the hardened Linux host.
# Copy to /etc/vaulted-guardian/guardian.env (mode 0640, root:vaulted-guardian).
# Secret values stay in tmpfs after manual unlock, never in this file.

VAULT_NETWORK=mainnet
VAULT_CLIENT_ORIGIN=https://app.getvaulted.xyz
VAULT_RP_ID=app.getvaulted.xyz
VAULT_AUTHORIZER_ADDR=127.0.0.1:8788

VAULT_DB_PATH=/var/lib/vaulted-guardian/data/vault.sqlite
VAULT_POLICY_SEQUENCE_PATH=/var/lib/vaulted-guardian/sequence/policy-sequence
VAULT_VAULT_COSIGNER_KEY_FILE=/run/vaulted-guardian/vault-cosigner.key
VAULT_ENROLLMENT_TOKEN_FILE=/run/vaulted-guardian/enrollment.token
VAULT_COSIGNER_KEY_UNLINK=after-load

VAULT_STORAGE_ISOLATION=independent-authorities
VAULT_EDGE_RATE_LIMIT=shared-durable
VAULT_MAINNET_ACK=fresh-state-v1

# Secret values are intentionally absent:
# VAULT_GATEWAY_SECRET
# VAULT_COSIGNER_KEY_HEX
# VAULT_ENROLLMENT_TOKEN

# Provision the mainnet signing endpoint privately; never commit its value.
VAULT_ARKADE_COSIGNER_ORIGIN=
