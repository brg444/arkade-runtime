# Mainnet must be a new service with new secrets and empty durable state.
VAULT_NETWORK=mainnet
VAULT_CLIENT_ORIGIN=https://app.getvaulted.xyz
VAULT_RP_ID=app.getvaulted.xyz

VAULT_DB_PATH=/app/data/vault.sqlite
VAULT_POLICY_SEQUENCE_PATH=/app/sequence/policy-sequence
VAULT_VAULT_COSIGNER_KEY_FILE=/run/secrets/vault_cosigner_key
VAULT_ENROLLMENT_TOKEN_FILE=/run/secrets/vault_enrollment_token

# Startup fails closed without these exact deployment declarations.
VAULT_STORAGE_ISOLATION=independent-authorities
VAULT_EDGE_RATE_LIMIT=shared-durable
VAULT_MAINNET_ACK=fresh-state-v1

# Secret values are intentionally absent:
# VAULT_GATEWAY_SECRET
