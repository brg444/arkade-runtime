# Copy to .env. Do not commit secrets.

VAULT_NETWORK=mutinynet
VAULT_CLIENT_ORIGIN=https://vault.example.com
VAULT_RP_ID=vault.example.com

VAULT_DB_PATH=/app/data/vault.sqlite
VAULT_POLICY_SEQUENCE_PATH=/app/sequence/policy-sequence
VAULT_VAULT_COSIGNER_KEY_FILE=/run/secrets/vault_cosigner_key
VAULT_ENROLLMENT_TOKEN_FILE=/run/secrets/vault_enrollment_token

# Required. openssl rand -hex 32
VAULT_GATEWAY_SECRET=
