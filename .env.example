# Copy to .env. Do not commit secrets.

EMULATOR_ROOT=/absolute/path/to/emulator

VAULT_NETWORK=mutinynet
VAULT_CLIENT_ORIGIN=https://vault.example.com
VAULT_RP_ID=vault.example.com

# Compressed secp256k1 hardware pub. Not G or 2G.
VAULT_EXTERNAL_OWNER_WALLET_PUB=02_REPLACE_WITH_REAL_66_HEX

# Device-only must exceed hardware-only.
VAULT_OPERATIONAL_CSV_BLOCKS=144
VAULT_SAVINGS_CSV_BLOCKS=6

VAULT_ESPLORA_URL=https://mempool.mutinynet.arkade.sh/api
VAULT_MULTI_TENANT_ENROLLMENT=1
VAULT_DB_PATH=/app/data/vault.sqlite
